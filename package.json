{
  "name": "color-weather",
  "author": "Digital Urban",
  "version": "2.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Color Weather",
    "uuid": "26561edc-d219-46de-8be2-9833c511e9e2",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "main": "src/pkjs/app.js",
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "SHOE_ICON",
          "file": "images/shoe_icon.png"
        },
        {
          "type": "font",
          "name": "WEATHER_FONT_36",
          "file": "fonts/weathericons-regular-webfont.ttf",
          "characterRegex": "[\\uf00d\\uf002\\uf013\\uf019\\uf01b\\uf014\\uf07b]"
        }
      ]
    },
    "capabilities": [
      "location",
      "configurable",
      "health"
    ],
    "messageKeys": {
      "PRESSURE": 0,
      "TEMPERATURE": 1,
      "CONDITIONS": 2,
      "HUMIDITY": 3,
      "WIND": 4,
      "PRECIP": 5,
      "LOCATION": 6,
      "PRESSURE_TREND": 7,
      "PRESSURE_TEST": 8,
      "TEMP_UNIT": 9,
      "WIND_UNIT": 10,
      "PRECIP_UNIT": 11,
      "HOURLY_VIBRATION": 12,
      "UPDATE_COUNTDOWN": 13,
      "SHOW_STEPS": 14,
      "STEP_UNIT": 15,
      "STEP_COUNT": 16,
      "STEP_DISTANCE": 17,
      "STORM_WARNING": 18,
      "DYNAMIC_BACKGROUND": 19
    }
  }
}
